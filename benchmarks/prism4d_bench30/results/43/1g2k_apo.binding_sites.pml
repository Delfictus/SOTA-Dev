# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
bg_color white
set cartoon_fancy_helices, 1
set cartoon_side_chain_helper, 1
set surface_quality, 1

# Load your structure (adjust path as needed)
# load 1g2k_apo.topology.pdb, protein
# show cartoon, protein
# color gray80, protein

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
select pocket_1_lining, (chain B and resi 105) or (chain B and resi 104) or (chain A and resi 91) or (chain B and resi 106) or (chain A and resi 87) or (chain B and resi 103) or (chain A and resi 88) or (chain B and resi 107) or (chain A and resi 92) or (chain B and resi 108) or (chain A and resi 90) or (chain A and resi 95) or (chain B and resi 102) or (chain A and resi 96) or (chain A and resi 94) or (chain A and resi 89) or (chain A and resi 29) or (chain A and resi 93) or (chain A and resi 86)
show sticks, pocket_1_lining
set stick_radius, 0.15, pocket_1_lining
select pocket_1_catalytic, (chain A and resi 95) or (chain A and resi 29)
color magenta, pocket_1_catalytic
select pocket_1_aromatic, (chain B and resi 105)
color forest, pocket_1_aromatic
select pocket_1_hydrophobic, (chain B and resi 104) or (chain B and resi 108) or (chain A and resi 90) or (chain B and resi 102) or (chain A and resi 89) or (chain A and resi 93)
color tv_yellow, pocket_1_hydrophobic
create pocket_1_surface, pocket_1_lining
show surface, pocket_1_surface
set surface_color, slate, pocket_1_surface
set transparency, 0.7, pocket_1_surface
pseudoatom pocket_1_center, pos=[12.219, 37.169, 1.643]
show spheres, pocket_1_center
set sphere_scale, 0.5, pocket_1_center
color red, pocket_1_center
group pocket_1, pocket_1_lining pocket_1_surface pocket_1_center pocket_1_catalytic pocket_1_aromatic pocket_1_hydrophobic

