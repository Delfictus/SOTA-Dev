# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
set bgColor white
lighting soft

# Load your structure (adjust path as needed)
# open 1hpv.topology.pdb
# cartoon
# color #1 gray80

# ========== Site 1 (ActiveSite) [DRUGGABLE] ==========
# Pocket 1 lining residues
name pocket1_lining #1/A:53,/A:52,/A:54,/A:48,/A:47,/A:55,/A:46,/A:49,/A:51,/A:50,/A:56
show pocket1_lining atoms
style pocket1_lining stick
color #1/A:55 magenta
color #1/A:53 forest green
color #1/A:54,/A:47,/A:46,/A:50,/A:56 gold
surface pocket1_lining
transparency pocket1_lining 70
color pocket1_lining slate gray
marker #101 position 6.375,10.832,2.177 color red radius 1.0
2dlabels text "Pocket 1 (81% druggable) *" xpos 0.02 ypos 0.95 color black size 14

