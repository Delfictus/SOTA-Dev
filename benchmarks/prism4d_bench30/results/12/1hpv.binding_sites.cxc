# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
set bgColor white
lighting soft

# Load your structure (adjust path as needed)
# open 1hpv.topology.pdb
# cartoon
# color #1 gray80

# ========== Site 1 (Unknown) [DRUGGABLE] ==========
# Pocket 1 lining residues
name pocket1_lining #1/A:6,/A:5,/A:7,/A:4,/A:3,/A:8,/A:9
show pocket1_lining atoms
style pocket1_lining stick
color #1/A:6 forest green
color #1/A:5,/A:3,/A:9 gold
surface pocket1_lining
transparency pocket1_lining 70
color pocket1_lining slate gray
marker #101 position 10.398,30.326,14.323 color red radius 1.0
2dlabels text "Pocket 1 (65% druggable) *" xpos 0.02 ypos 0.95 color black size 14

