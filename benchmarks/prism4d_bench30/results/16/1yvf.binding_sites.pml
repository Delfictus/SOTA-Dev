# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
bg_color white
set cartoon_fancy_helices, 1
set cartoon_side_chain_helper, 1
set surface_quality, 1

# Load your structure (adjust path as needed)
# load 1yvf.topology.pdb, protein
# show cartoon, protein
# color gray80, protein

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
select pocket_1_lining, (chain A and resi 501) or (chain A and resi 500) or (chain A and resi 498) or (chain A and resi 497) or (chain A and resi 496) or (chain A and resi 425) or (chain A and resi 502) or (chain A and resi 495) or (chain A and resi 424) or (chain A and resi 504) or (chain A and resi 499) or (chain A and resi 428) or (chain A and resi 490) or (chain A and resi 503) or (chain A and resi 31) or (chain A and resi 505) or (chain A and resi 529) or (chain A and resi 30) or (chain A and resi 429) or (chain A and resi 426)
show sticks, pocket_1_lining
set stick_radius, 0.15, pocket_1_lining
select pocket_1_catalytic, (chain A and resi 30)
color magenta, pocket_1_catalytic
select pocket_1_aromatic, (chain A and resi 501) or (chain A and resi 529)
color forest, pocket_1_aromatic
select pocket_1_hydrophobic, (chain A and resi 500) or (chain A and resi 498) or (chain A and resi 497) or (chain A and resi 496) or (chain A and resi 425) or (chain A and resi 495) or (chain A and resi 424) or (chain A and resi 490) or (chain A and resi 31) or (chain A and resi 505) or (chain A and resi 426)
color tv_yellow, pocket_1_hydrophobic
create pocket_1_surface, pocket_1_lining
show surface, pocket_1_surface
set surface_color, slate, pocket_1_surface
set transparency, 0.7, pocket_1_surface
pseudoatom pocket_1_center, pos=[-11.468, 52.897, 70.429]
show spheres, pocket_1_center
set sphere_scale, 0.5, pocket_1_center
color red, pocket_1_center
group pocket_1, pocket_1_lining pocket_1_surface pocket_1_center pocket_1_catalytic pocket_1_aromatic pocket_1_hydrophobic

