# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
set bgColor white
lighting soft

# Load your structure (adjust path as needed)
# open 1nna.topology.pdb
# cartoon
# color #1 gray80

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
# Pocket 1 lining residues
name pocket1_lining #1/A:331,/A:332,/A:44,/A:329,/A:333,/A:330,/A:7,/A:1
show pocket1_lining atoms
style pocket1_lining stick
color #1/A:329,/A:333,/A:7,/A:1 magenta
color #1/A:331,/A:330 forest green
color #1/A:332,/A:44 gold
surface pocket1_lining
transparency pocket1_lining 70
color pocket1_lining slate gray
marker #101 position 7.539,18.133,39.842 color red radius 1.0
2dlabels text "Pocket 1 (84% druggable) *" xpos 0.02 ypos 0.95 color black size 14

