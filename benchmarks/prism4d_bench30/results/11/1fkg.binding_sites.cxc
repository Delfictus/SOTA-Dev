# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
set bgColor white
lighting soft

# Load your structure (adjust path as needed)
# open 1fkg.topology.pdb
# cartoon
# color #1 gray80

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
# Pocket 1 lining residues
name pocket1_lining #1/A:15,/A:12,/A:13,/A:67,/A:65,/A:17,/A:14,/A:66,/A:64,/A:70,/A:11,/A:16,/A:68
show pocket1_lining atoms
style pocket1_lining stick
color #1/A:67,/A:17,/A:11 magenta
color #1/A:15 forest green
color #1/A:66,/A:64,/A:16,/A:68 gold
surface pocket1_lining
transparency pocket1_lining 70
color pocket1_lining slate gray
marker #101 position -15.724,15.705,-8.128 color red radius 1.0
2dlabels text "Pocket 1 (78% druggable) *" xpos 0.02 ypos 0.95 color black size 14

