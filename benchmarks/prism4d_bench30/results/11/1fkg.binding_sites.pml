# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
bg_color white
set cartoon_fancy_helices, 1
set cartoon_side_chain_helper, 1
set surface_quality, 1

# Load your structure (adjust path as needed)
# load 1fkg.topology.pdb, protein
# show cartoon, protein
# color gray80, protein

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
select pocket_1_lining, (chain A and resi 15) or (chain A and resi 12) or (chain A and resi 13) or (chain A and resi 67) or (chain A and resi 65) or (chain A and resi 17) or (chain A and resi 14) or (chain A and resi 66) or (chain A and resi 64) or (chain A and resi 70) or (chain A and resi 11) or (chain A and resi 16) or (chain A and resi 68)
show sticks, pocket_1_lining
set stick_radius, 0.15, pocket_1_lining
select pocket_1_catalytic, (chain A and resi 67) or (chain A and resi 17) or (chain A and resi 11)
color magenta, pocket_1_catalytic
select pocket_1_aromatic, (chain A and resi 15)
color forest, pocket_1_aromatic
select pocket_1_hydrophobic, (chain A and resi 66) or (chain A and resi 64) or (chain A and resi 16) or (chain A and resi 68)
color tv_yellow, pocket_1_hydrophobic
create pocket_1_surface, pocket_1_lining
show surface, pocket_1_surface
set surface_color, slate, pocket_1_surface
set transparency, 0.7, pocket_1_surface
pseudoatom pocket_1_center, pos=[-15.724, 15.705, -8.128]
show spheres, pocket_1_center
set sphere_scale, 0.5, pocket_1_center
color red, pocket_1_center
group pocket_1, pocket_1_lining pocket_1_surface pocket_1_center pocket_1_catalytic pocket_1_aromatic pocket_1_hydrophobic

# ========== Site 2 (ActiveSite) [DRUGGABLE] ==========
select pocket_2_lining, (chain A and resi 44) or (chain A and resi 46) or (chain A and resi 45) or (chain A and resi 47) or (chain A and resi 26) or (chain A and resi 39) or (chain A and resi 42) or (chain A and resi 24) or (chain A and resi 23) or (chain A and resi 25) or (chain A and resi 48)
show sticks, pocket_2_lining
set stick_radius, 0.15, pocket_2_lining
select pocket_2_catalytic, (chain A and resi 44) or (chain A and resi 47) or (chain A and resi 39)
color magenta, pocket_2_catalytic
select pocket_2_aromatic, (chain A and resi 46) or (chain A and resi 26) or (chain A and resi 48)
color forest, pocket_2_aromatic
select pocket_2_hydrophobic, (chain A and resi 45) or (chain A and resi 24) or (chain A and resi 23)
color tv_yellow, pocket_2_hydrophobic
create pocket_2_surface, pocket_2_lining
show surface, pocket_2_surface
set surface_color, slate, pocket_2_surface
set transparency, 0.7, pocket_2_surface
pseudoatom pocket_2_center, pos=[-29.050, 28.232, -3.476]
show spheres, pocket_2_center
set sphere_scale, 0.5, pocket_2_center
color red, pocket_2_center
group pocket_2, pocket_2_lining pocket_2_surface pocket_2_center pocket_2_catalytic pocket_2_aromatic pocket_2_hydrophobic

# ========== Site 3 (Unknown) [DRUGGABLE] ==========
select pocket_3_lining, (chain A and resi 47) or (chain A and resi 48) or (chain A and resi 46) or (chain A and resi 21) or (chain A and resi 54) or (chain A and resi 49) or (chain A and resi 52) or (chain A and resi 22) or (chain A and resi 23) or (chain A and resi 55) or (chain A and resi 44) or (chain A and resi 24) or (chain A and resi 45) or (chain A and resi 59)
show sticks, pocket_3_lining
set stick_radius, 0.15, pocket_3_lining
select pocket_3_catalytic, (chain A and resi 47) or (chain A and resi 54) or (chain A and resi 52) or (chain A and resi 22) or (chain A and resi 44)
color magenta, pocket_3_catalytic
select pocket_3_aromatic, (chain A and resi 48) or (chain A and resi 46) or (chain A and resi 59)
color forest, pocket_3_aromatic
select pocket_3_hydrophobic, (chain A and resi 49) or (chain A and resi 23) or (chain A and resi 55) or (chain A and resi 24) or (chain A and resi 45)
color tv_yellow, pocket_3_hydrophobic
create pocket_3_surface, pocket_3_lining
show surface, pocket_3_surface
set surface_color, slate, pocket_3_surface
set transparency, 0.7, pocket_3_surface
pseudoatom pocket_3_center, pos=[-24.868, 28.447, -3.261]
show spheres, pocket_3_center
set sphere_scale, 0.5, pocket_3_center
color red, pocket_3_center
group pocket_3, pocket_3_lining pocket_3_surface pocket_3_center pocket_3_catalytic pocket_3_aromatic pocket_3_hydrophobic

# ========== Site 4 (Unknown) [DRUGGABLE] ==========
select pocket_4_lining, (chain A and resi 73) or (chain A and resi 98) or (chain A and resi 29) or (chain A and resi 100) or (chain A and resi 7) or (chain A and resi 5) or (chain A and resi 33) or (chain A and resi 75) or (chain A and resi 99) or (chain A and resi 30) or (chain A and resi 74) or (chain A and resi 72) or (chain A and resi 27) or (chain A and resi 31)
show sticks, pocket_4_lining
set stick_radius, 0.15, pocket_4_lining
select pocket_4_catalytic, (chain A and resi 73) or (chain A and resi 100) or (chain A and resi 5) or (chain A and resi 31)
color magenta, pocket_4_catalytic
select pocket_4_aromatic, (chain A and resi 99)
color forest, pocket_4_aromatic
select pocket_4_hydrophobic, (chain A and resi 98) or (chain A and resi 29) or (chain A and resi 7) or (chain A and resi 30) or (chain A and resi 74) or (chain A and resi 72)
color tv_yellow, pocket_4_hydrophobic
create pocket_4_surface, pocket_4_lining
show surface, pocket_4_surface
set surface_color, slate, pocket_4_surface
set transparency, 0.7, pocket_4_surface
pseudoatom pocket_4_center, pos=[-28.104, 14.428, 2.168]
show spheres, pocket_4_center
set sphere_scale, 0.5, pocket_4_center
color red, pocket_4_center
group pocket_4, pocket_4_lining pocket_4_surface pocket_4_center pocket_4_catalytic pocket_4_aromatic pocket_4_hydrophobic

group all_pockets, pocket_1 pocket_2 pocket_3 pocket_4

# ========== Color Legend ==========
# Magenta = Catalytic residues (GLU, ASP, HIS, SER, CYS, LYS)
# Green = Aromatic residues (PHE, TYR, TRP) - pi-stacking
# Yellow = Hydrophobic residues (ALA, VAL, LEU, ILE, MET, PRO)
# Slate surface = Pocket cavity
# Red sphere = Druggable site centroid
# Gray sphere = Non-druggable site centroid

# ========== Usage Tips ==========
# To view specific pocket: disable all_pockets, enable pocket_N
# To zoom on pocket: zoom pocket_N_lining
# To show H-bonds: select donors, pocket_N_lining; distance hbonds, donors, acceptors, 3.5
# To label residues: label pocket_N_lining and name CA, "%s%s" % (resn, resi)
