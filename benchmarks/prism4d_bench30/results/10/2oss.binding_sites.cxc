style pocket1_lining stick
color #1/A:95,/A:100,/A:110,/A:113 magenta
color #1/A:96,/A:92,/A:98 forest green
color #1/A:101,/A:97,/A:106,/A:109 gold
surface pocket1_lining
transparency pocket1_lining 70
color pocket1_lining slate gray
marker #101 position 18.604,40.779,0.198 color red radius 1.0
2dlabels text "Pocket 1 (64% druggable) *" xpos 0.02 ypos 0.95 color black size 14

