select pocket_1_catalytic, (chain A and resi 517) or (chain A and resi 526) or (chain A and resi 400)
color magenta, pocket_1_catalytic
select pocket_1_aromatic, (chain A and resi 519) or (chain A and resi 520) or (chain A and resi 523) or (chain A and resi 373)
