# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
bg_color white
set cartoon_fancy_helices, 1
set cartoon_side_chain_helper, 1
set surface_quality, 1

# Load your structure (adjust path as needed)
# load 1abf.topology.pdb, protein
# show cartoon, protein
# color gray80, protein

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
select pocket_1_lining, (chain A and resi 289) or (chain A and resi 290) or (chain A and resi 248) or (chain A and resi 291) or (chain A and resi 239) or (chain A and resi 249) or (chain A and resi 292) or (chain A and resi 123) or (chain A and resi 127) or (chain A and resi 287) or (chain A and resi 247) or (chain A and resi 126) or (chain A and resi 288) or (chain A and resi 245) or (chain A and resi 228) or (chain A and resi 244) or (chain A and resi 293) or (chain A and resi 226) or (chain A and resi 250)
show sticks, pocket_1_lining
set stick_radius, 0.15, pocket_1_lining
select pocket_1_catalytic, (chain A and resi 291) or (chain A and resi 123) or (chain A and resi 126) or (chain A and resi 250)
color magenta, pocket_1_catalytic
select pocket_1_aromatic, (chain A and resi 248) or (chain A and resi 247) or (chain A and resi 293)
color forest, pocket_1_aromatic
select pocket_1_hydrophobic, (chain A and resi 239) or (chain A and resi 287) or (chain A and resi 288) or (chain A and resi 228) or (chain A and resi 244) or (chain A and resi 226)
color tv_yellow, pocket_1_hydrophobic
