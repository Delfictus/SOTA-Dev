select pocket_16_lining, (chain A and resi 187) or (chain A and resi 171) or (chain A and resi 172) or (chain A and resi 184) or (chain A and resi 183) or (chain A and resi 191) or (chain A and resi 174) or (chain A and resi 188) or (chain A and resi 186) or (chain A and resi 185) or (chain A and resi 190) or (chain A and resi 173)
show sticks, pocket_16_lining
set stick_radius, 0.15, pocket_16_lining
select pocket_16_catalytic, (chain A and resi 187) or (chain A and resi 183) or (chain A and resi 174)
color magenta, pocket_16_catalytic
select pocket_16_hydrophobic, (chain A and resi 171) or (chain A and resi 172) or (chain A and resi 184) or (chain A and resi 188) or (chain A and resi 185) or (chain A and resi 190)
color tv_yellow, pocket_16_hydrophobic
create pocket_16_surface, pocket_16_lining
show surface, pocket_16_surface
set surface_color, slate, pocket_16_surface
set transparency, 0.7, pocket_16_surface
pseudoatom pocket_16_center, pos=[4.912, 70.185, 63.045]
show spheres, pocket_16_center
set sphere_scale, 0.5, pocket_16_center
color red, pocket_16_center
group pocket_16, pocket_16_lining pocket_16_surface pocket_16_center pocket_16_catalytic pocket_16_hydrophobic

group all_pockets, pocket_1 pocket_2 pocket_3 pocket_4 pocket_5 pocket_6 pocket_7 pocket_8 pocket_9 pocket_10 pocket_11 pocket_12 pocket_13 pocket_14 pocket_15 pocket_16

# ========== Color Legend ==========
# Magenta = Catalytic residues (GLU, ASP, HIS, SER, CYS, LYS)
# Green = Aromatic residues (PHE, TYR, TRP) - pi-stacking
# Yellow = Hydrophobic residues (ALA, VAL, LEU, ILE, MET, PRO)
# Slate surface = Pocket cavity
# Red sphere = Druggable site centroid
# Gray sphere = Non-druggable site centroid

# ========== Usage Tips ==========
# To view specific pocket: disable all_pockets, enable pocket_N
# To zoom on pocket: zoom pocket_N_lining
# To show H-bonds: select donors, pocket_N_lining; distance hbonds, donors, acceptors, 3.5
# To label residues: label pocket_N_lining and name CA, "%s%s" % (resn, resi)
