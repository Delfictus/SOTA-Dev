# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
bg_color white
set cartoon_fancy_helices, 1
set cartoon_side_chain_helper, 1
set surface_quality, 1

# Load your structure (adjust path as needed)
# load 1tpa.topology.pdb, protein
# show cartoon, protein
# color gray80, protein

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
select pocket_1_lining, (chain E and resi 5) or (chain E and resi 7) or (chain E and resi 6) or (chain E and resi 137) or (chain E and resi 11) or (chain E and resi 8) or (chain E and resi 12) or (chain E and resi 117) or (chain E and resi 139) or (chain E and resi 136) or (chain E and resi 135) or (chain E and resi 138) or (chain E and resi 119) or (chain E and resi 53) or (chain E and resi 9) or (chain E and resi 4)
show sticks, pocket_1_lining
set stick_radius, 0.15, pocket_1_lining
select pocket_1_catalytic, (chain E and resi 7) or (chain E and resi 137) or (chain E and resi 139) or (chain E and resi 136) or (chain E and resi 119) or (chain E and resi 53)
color magenta, pocket_1_catalytic
select pocket_1_aromatic, (chain E and resi 5)
color forest, pocket_1_aromatic
select pocket_1_hydrophobic, (chain E and resi 12) or (chain E and resi 117) or (chain E and resi 135) or (chain E and resi 138) or (chain E and resi 9)
color tv_yellow, pocket_1_hydrophobic
create pocket_1_surface, pocket_1_lining
show surface, pocket_1_surface
set surface_color, slate, pocket_1_surface
set transparency, 0.7, pocket_1_surface
pseudoatom pocket_1_center, pos=[15.737, 55.942, 13.984]
show spheres, pocket_1_center
set sphere_scale, 0.5, pocket_1_center
color red, pocket_1_center
group pocket_1, pocket_1_lining pocket_1_surface pocket_1_center pocket_1_catalytic pocket_1_aromatic pocket_1_hydrophobic

