style pocket1_lining stick
color #1/A:186 magenta
color #1/A:198,/A:249,/A:245,/A:182,/A:162 forest green
color #1/A:197,/A:213,/A:209,/A:210,/A:199,/A:248,/A:264,/A:189,/A:214 gold
surface pocket1_lining
transparency pocket1_lining 70
color pocket1_lining slate gray
marker #101 position 13.495,33.196,23.974 color red radius 1.0
2dlabels text "Pocket 1 (80% druggable) *" xpos 0.02 ypos 0.95 color black size 14

