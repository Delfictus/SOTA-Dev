set transparency, 0.7, pocket_11_surface
pseudoatom pocket_11_center, pos=[-7.527, -6.668, 35.172]
show spheres, pocket_11_center
set sphere_scale, 0.5, pocket_11_center
color red, pocket_11_center
group pocket_11, pocket_11_lining pocket_11_surface pocket_11_center pocket_11_catalytic pocket_11_hydrophobic

# ========== Site 12 (Unknown) [DRUGGABLE] ==========
select pocket_12_lining, (chain A and resi 164) or (chain A and resi 165) or (chain A and resi 161) or (chain A and resi 226) or (chain A and resi 230) or (chain A and resi 234) or (chain A and resi 224) or (chain A and resi 228) or (chain A and resi 231) or (chain A and resi 162) or (chain A and resi 168) or (chain A and resi 225) or (chain A and resi 163) or (chain A and resi 160) or (chain A and resi 229) or (chain A and resi 236) or (chain A and resi 58) or (chain A and resi 232) or (chain A and resi 166) or (chain A and resi 235)
show sticks, pocket_12_lining
set stick_radius, 0.15, pocket_12_lining
select pocket_12_catalytic, (chain A and resi 164) or (chain A and resi 161) or (chain A and resi 230) or (chain A and resi 234) or (chain A and resi 224) or (chain A and resi 162) or (chain A and resi 168) or (chain A and resi 232) or (chain A and resi 166) or (chain A and resi 235)
color magenta, pocket_12_catalytic
select pocket_12_hydrophobic, (chain A and resi 225) or (chain A and resi 163) or (chain A and resi 160) or (chain A and resi 236)
color tv_yellow, pocket_12_hydrophobic
create pocket_12_surface, pocket_12_lining
show surface, pocket_12_surface
set surface_color, slate, pocket_12_surface
set transparency, 0.7, pocket_12_surface
pseudoatom pocket_12_center, pos=[-4.641, -7.536, -3.871]
show spheres, pocket_12_center
set sphere_scale, 0.5, pocket_12_center
color red, pocket_12_center
group pocket_12, pocket_12_lining pocket_12_surface pocket_12_center pocket_12_catalytic pocket_12_hydrophobic

group all_pockets, pocket_1 pocket_2 pocket_3 pocket_4 pocket_5 pocket_6 pocket_7 pocket_8 pocket_9 pocket_10 pocket_11 pocket_12

# ========== Color Legend ==========
# Magenta = Catalytic residues (GLU, ASP, HIS, SER, CYS, LYS)
# Green = Aromatic residues (PHE, TYR, TRP) - pi-stacking
# Yellow = Hydrophobic residues (ALA, VAL, LEU, ILE, MET, PRO)
# Slate surface = Pocket cavity
# Red sphere = Druggable site centroid
# Gray sphere = Non-druggable site centroid

# ========== Usage Tips ==========
# To view specific pocket: disable all_pockets, enable pocket_N
# To zoom on pocket: zoom pocket_N_lining
# To show H-bonds: select donors, pocket_N_lining; distance hbonds, donors, acceptors, 3.5
# To label residues: label pocket_N_lining and name CA, "%s%s" % (resn, resi)
