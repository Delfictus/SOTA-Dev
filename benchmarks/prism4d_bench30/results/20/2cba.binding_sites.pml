# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
bg_color white
set cartoon_fancy_helices, 1
set cartoon_side_chain_helper, 1
set surface_quality, 1

# Load your structure (adjust path as needed)
# load 2cba.topology.pdb, protein
# show cartoon, protein
# color gray80, protein

# ========== Site 1 (ActiveSite) [DRUGGABLE] ==========
select pocket_1_lining, (chain A and resi 206) or (chain A and resi 191) or (chain A and resi 192) or (chain A and resi 193) or (chain A and resi 190) or (chain A and resi 205) or (chain A and resi 207) or (chain A and resi 27) or (chain A and resi 204) or (chain A and resi 208) or (chain A and resi 29) or (chain A and resi 251) or (chain A and resi 253) or (chain A and resi 105) or (chain A and resi 194) or (chain A and resi 189) or (chain A and resi 140) or (chain A and resi 25) or (chain A and resi 31) or (chain A and resi 81) or (chain A and resi 28) or (chain A and resi 254) or (chain A and resi 248) or (chain A and resi 139) or (chain A and resi 142) or (chain A and resi 252) or (chain A and resi 26) or (chain A and resi 188)
