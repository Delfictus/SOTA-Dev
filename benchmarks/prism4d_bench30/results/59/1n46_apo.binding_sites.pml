# ========== Site 23 (Unknown) [DRUGGABLE] ==========
select pocket_23_lining, (chain B and resi 283) or (chain B and resi 287) or (chain B and resi 288) or (chain B and resi 363) or (chain B and resi 366) or (chain B and resi 284) or (chain B and resi 365) or (chain B and resi 286) or (chain B and resi 369) or (chain B and resi 282) or (chain B and resi 285) or (chain B and resi 281) or (chain B and resi 364) or (chain B and resi 353) or (chain B and resi 362) or (chain B and resi 367) or (chain B and resi 351)
show sticks, pocket_23_lining
set stick_radius, 0.15, pocket_23_lining
select pocket_23_catalytic, (chain B and resi 283) or (chain B and resi 284) or (chain B and resi 351)
color magenta, pocket_23_catalytic
select pocket_23_hydrophobic, (chain B and resi 288) or (chain B and resi 282) or (chain B and resi 285) or (chain B and resi 281) or (chain B and resi 362) or (chain B and resi 367)
color tv_yellow, pocket_23_hydrophobic
create pocket_23_surface, pocket_23_lining
show surface, pocket_23_surface
set surface_color, slate, pocket_23_surface
set transparency, 0.7, pocket_23_surface
pseudoatom pocket_23_center, pos=[13.834, -34.299, -25.320]
show spheres, pocket_23_center
set sphere_scale, 0.5, pocket_23_center
color red, pocket_23_center
group pocket_23, pocket_23_lining pocket_23_surface pocket_23_center pocket_23_catalytic pocket_23_hydrophobic

group all_pockets, pocket_1 pocket_2 pocket_3 pocket_4 pocket_5 pocket_6 pocket_7 pocket_8 pocket_9 pocket_10 pocket_11 pocket_12 pocket_13 pocket_14 pocket_15 pocket_16 pocket_17 pocket_18 pocket_19 pocket_20 pocket_21 pocket_22 pocket_23

# ========== Color Legend ==========
# Magenta = Catalytic residues (GLU, ASP, HIS, SER, CYS, LYS)
# Green = Aromatic residues (PHE, TYR, TRP) - pi-stacking
# Yellow = Hydrophobic residues (ALA, VAL, LEU, ILE, MET, PRO)
# Slate surface = Pocket cavity
# Red sphere = Druggable site centroid
# Gray sphere = Non-druggable site centroid

# ========== Usage Tips ==========
# To view specific pocket: disable all_pockets, enable pocket_N
# To zoom on pocket: zoom pocket_N_lining
# To show H-bonds: select donors, pocket_N_lining; distance hbonds, donors, acceptors, 3.5
# To label residues: label pocket_N_lining and name CA, "%s%s" % (resn, resi)
