# PRISM4D Binding Site Visualization
# Generated by prism-nhs
# Industry-standard pocket visualization

# Setup
bg_color white
set cartoon_fancy_helices, 1
set cartoon_side_chain_helper, 1
set surface_quality, 1

# Load your structure (adjust path as needed)
# load 1pkl.topology.pdb, protein
# show cartoon, protein
# color gray80, protein

# ========== Site 1 (Cryptic) [DRUGGABLE] ==========
select pocket_1_lining, (chain A and resi 363) or (chain A and resi 364) or (chain A and resi 362) or (chain A and resi 412) or (chain A and resi 360) or (chain A and resi 413) or (chain A and resi 359) or (chain A and resi 389) or (chain A and resi 365) or (chain A and resi 366) or (chain A and resi 361) or (chain A and resi 385) or (chain A and resi 411) or (chain A and resi 414) or (chain A and resi 367) or (chain A and resi 358) or (chain A and resi 410) or (chain A and resi 415) or (chain A and resi 409) or (chain A and resi 435) or (chain A and resi 386)
show sticks, pocket_1_lining
set stick_radius, 0.15, pocket_1_lining
select pocket_1_catalytic, (chain A and resi 359) or (chain A and resi 365) or (chain A and resi 411) or (chain A and resi 367)
color magenta, pocket_1_catalytic
select pocket_1_aromatic, (chain A and resi 363) or (chain A and resi 362) or (chain A and resi 412) or (chain A and resi 360) or (chain A and resi 389)
color forest, pocket_1_aromatic
select pocket_1_hydrophobic, (chain A and resi 366) or (chain A and resi 361) or (chain A and resi 385) or (chain A and resi 414) or (chain A and resi 410) or (chain A and resi 409)
color tv_yellow, pocket_1_hydrophobic
create pocket_1_surface, pocket_1_lining
show surface, pocket_1_surface
set surface_color, slate, pocket_1_surface
set transparency, 0.7, pocket_1_surface
pseudoatom pocket_1_center, pos=[116.004, 106.558, 18.582]
show spheres, pocket_1_center
set sphere_scale, 0.5, pocket_1_center
color red, pocket_1_center
group pocket_1, pocket_1_lining pocket_1_surface pocket_1_center pocket_1_catalytic pocket_1_aromatic pocket_1_hydrophobic

