+def plot_csv(path: Path, x_key: str, y_key: str, output: Path, ylabel: str) -> None:
+    df = pl.read_csv(path)
+    plt.figure(figsize=(7, 4))
+    plt.plot(df.get_column(x_key), df.get_column(y_key), marker="o", linewidth=1.5)
