+    }
+}
+
+#[derive(Debug, Clone)]
+struct SurvivorReward {
+    anchor_id: String,
+    canonical_smiles: String,
+    reward: f64,
+    pi_complement: f64,
+    adjusted_pi_clash: f64,
+    pi_clash_pocket: f64,
