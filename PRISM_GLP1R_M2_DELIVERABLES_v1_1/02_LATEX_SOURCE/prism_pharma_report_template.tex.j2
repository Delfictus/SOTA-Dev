% --- text-overflow hardening (margin protection) ----------------------
\emergencystretch=8em
\tolerance=4000
\hbadness=10000
% Hyphenate aggressively; permits breaks inside words to avoid
% margin overflow when a long token is the only choice.
\hyphenpenalty=200
\exhyphenpenalty=200
\pretolerance=-1
\linepenalty=10
\setlength{\parskip}{4pt plus 1pt minus 1pt}
% Apply \sloppy globally — relaxes line-break tolerance, prevents most
% small textual overflow.
\AtBeginDocument{\sloppy}

% Make every longtable (including pandoc-generated ones) use small font
% and tighter column padding so wide tables fit. Combined with the
% post-processor that converts wide longtables to xltabular X-cols,
% this prevents the catastrophic 1000pt+ overflows.
\AtBeginEnvironment{longtable}{\small\setlength{\tabcolsep}{3pt}\setlength{\arrayrulewidth}{0.3pt}}
\AtBeginEnvironment{xltabular}{\small\setlength{\tabcolsep}{3pt}\setlength{\arrayrulewidth}{0.3pt}}

% \texttt content that is one long hex / id blob gets line-broken by
% \seqsplit. Wrappers around hashes injected by the build-script
% post-processor.

% Allow URL breaks anywhere — applies to hyperref-styled URLs.
\PassOptionsToPackage{hyphens}{url}

